# Local secret placeholders — copy to `.env` and set real local values. Never commit `.env`.
# (docs/deployment.md → Configuration, NFR-SEC-03: secrets are never hardcoded or committed.)

# Keycloak identity provider
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Business service databases (local dev defaults)
CUSTOMER_DB_PASSWORD=customer_db

# Shared service configuration (defaults are baked into application.yml)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/enterprise
EUREKA_URI=http://localhost:8761/eureka/
REDIS_HOST=localhost
REDIS_PORT=6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
